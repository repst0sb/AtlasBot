      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"user\" (telegram_id, username)\nSELECT {{ $json.message.chat.id }}, '{{ $json.message.from.username }}'\nWHERE NOT EXISTS (\n    SELECT 1 FROM \"user\" WHERE telegram_id = {{ $json.message.chat.id }}\n);",
