    {
      "parameters": {
        "jsCode": "const text = $input.item.json.message.text;\nconst [route, date, time] = text.split(', ');\nconst [dep, arr] = route.split(' - ');\nconst [time_from, time_to] = time.split('-');\n\nconst inputDate = new Date(date);\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0); \n\nlet is_valid = true;\nlet error_msg = \"\";\n\nif (inputDate < today) {\n    is_valid = false;\n    error_msg = \"❌ Ошибка: Дата не может быть в прошлом. Пожалуйста, введите актуальную дату.\";\n}\n\nreturn { dep, arr, date, time_from, time_to, is_valid, error_msg };"
      },
