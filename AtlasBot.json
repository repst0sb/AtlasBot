    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO subscription (user_id, departure_city_id, arrival_city_id, date, time_from, time_to, status)\nSELECT \n    u.user_id,\n    c1.city_id,\n    c2.city_id,\n    '{{ $('subscription processing').item.json.date }}'::date,\n    '{{ $('subscription processing').item.json.time_from }}'::time,\n    '{{ $('subscription processing').item.json.time_to }}'::time,\n    'active'\nFROM \"user\" u\nCROSS JOIN city c1\nCROSS JOIN city c2\nWHERE u.telegram_id = {{ $('Telegram Trigger').first().json.message.chat.id }}\n  AND LOWER(c1.name) = LOWER('{{ $('subscription processing').item.json.dep }}')\n  AND LOWER(c2.name) = LOWER('{{ $('subscription processing').item.json.arr }}')\n  AND c1.city_id != c2.city_id\n  -- Проверка на дубликат:\n  AND NOT EXISTS (\n      SELECT 1 FROM subscription s \n      WHERE s.user_id = u.user_id \n        AND s.departure_city_id = c1.city_id \n        AND s.arrival_city_id = c2.city_id \n        AND s.date = '{{ $('subscription processing').item.json.date }}'::date\n  )\nRETURNING subscription_id;",
        "options": {}
      },
