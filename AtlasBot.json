    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nif (items.length === 0 || !items[0].subscription_id) {\n    return [{ json: { text: \"У вас нет активных отслеживаний.\" } }];\n}\n\nlet listText = \"📋 <b>Ваши отслеживания:</b>\\n\\n\";\n\nitems.forEach((item, index) => {\n    listText += `<b>${index + 1}.</b> 📍 ${item.dep_name} - ${item.arr_name}\\n`;\n    listText += `📅 Дата: ${item.date}\\n`;\n    listText += `⏰ Время: ${item.time_from} - ${item.time_to}\\n`;\n    listText += `❌ Для удаления нажмите: /del${item.subscription_id}\\n\\n`;\n});\n\nreturn [{ json: { text: listText } }];"
      },
