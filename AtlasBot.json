    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO subscription (user_id, departure_city_id, arrival_city_id, date, time_from, time_to, status)\nSELECT \n    u.user_id,\n    c1.city_id,\n    c2.city_id,\n    '{{ $json.date }}'::date,\n    '{{ $json.time_from }}'::time,\n    '{{ $json.time_to }}'::time,\n    'active'\nFROM \"user\" u\nCROSS JOIN city c1\nCROSS JOIN city c2\nWHERE u.telegram_id = {{ $('Telegram Trigger').first().json.message.chat.id }}\n  AND LOWER(c1.name) = LOWER('{{ $json.dep }}')\n  AND LOWER(c2.name) = LOWER('{{ $json.arr }}')\n  AND c1.city_id != c2.city_id;",
        "options": {}
      },
