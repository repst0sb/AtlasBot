    {
      "parameters": {
        "jsCode": "const text = $input.item.json.message.text;\nconst [route, date, time] = text.split(', ');\nconst [dep, arr] = route.split(' - ');\nconst [time_from, time_to] = time.split('-');\n\nconst inputDate = new Date(date);\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0); \n\nlet is_valid = true;\nlet error_msg = \"\";\n\nif (inputDate < today) {\n    is_valid = false;\n    error_msg = \"❌ Ошибка: Дата не может быть в прошлом. Пожалуйста, введите актуальную дату.\";\n}\n\nreturn { dep, arr, date, time_from, time_to, is_valid, error_msg };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        432
      ],
      "id": "76445b3f-2aed-4c9c-9c0e-7b614a049953",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO subscription (user_id, departure_city_id, arrival_city_id, date, time_from, time_to, status)\nSELECT \n    u.user_id,\n    c1.city_id,\n    c2.city_id,\n    '{{ $json.date }}'::date,\n    '{{ $json.time_from }}'::time,\n    '{{ $json.time_to }}'::time,\n    'active'\nFROM \"user\" u\nCROSS JOIN city c1\nCROSS JOIN city c2\nWHERE u.telegram_id = {{ $('Telegram Trigger').first().json.message.chat.id }}\n  AND LOWER(c1.name) = LOWER('{{ $json.dep }}')\n  AND LOWER(c2.name) = LOWER('{{ $json.arr }}')\n  AND c1.city_id != c2.city_id\n  -- Проверка на дубликат:\n  AND NOT EXISTS (\n      SELECT 1 FROM subscription s \n      WHERE s.user_id = u.user_id \n        AND s.departure_city_id = c1.city_id \n        AND s.arrival_city_id = c2.city_id \n        AND s.date = '{{ $json.date }}'::date\n  )\nRETURNING subscription_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        704,
        416
      ],
