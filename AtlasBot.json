    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    s.subscription_id, \n    TO_CHAR(s.date, 'YYYY-MM-DD') as date, \n    TO_CHAR(s.time_from, 'HH24:MI') as time_from, \n    TO_CHAR(s.time_to, 'HH24:MI') as time_to, \n    c1.name as dep_name, \n    c2.name as arr_name\nFROM subscription s\nJOIN \"user\" u ON s.user_id = u.user_id\nJOIN city c1 ON s.departure_city_id = c1.city_id\nJOIN city c2 ON s.arrival_city_id = c2.city_id\nWHERE u.telegram_id = {{ $('Telegram Trigger').first().json.callback_query.message.chat.id }};",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
