    {
      "parameters": {
        "jsCode": "const alphabet = 'абвгдежзийклмнопрстуфхцчшщэюя'.split('');\n\nreturn alphabet.map(letter => ({\n  json: { letter }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "7a6f55e1-620b-41ac-bc95-4e1e9ba88245",
      "name": "Generate Alphabet"
    },
    {
      "parameters": {
        "url": "https://atlasbus.by/api/search/suggest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_input",
              "value": "={{ $json.letter }}"
            },
            {
              "name": "locale",
              "value": "ru"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
