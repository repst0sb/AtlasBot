      ],
      "id": "aa64b605-6766-45e4-a733-09c7162543a0",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const citiesMap = new Map();\n\nfor (const item of $input.all()) {\n  const city = item.json;\n\n  if (city && city.country === 'BY' && city.id && city.name) {\n    citiesMap.set(String(city.id), String(city.name).trim());\n  }\n}\n\nreturn Array.from(citiesMap.entries()).map(([id, name]) => ({\n  json: {\n    atlas_city_id: id,\n    name: name\n  },\n  pairedItem: []\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "e23c6d84-696d-44e5-b1b2-0d4d9cff2adc",
      "name": "Parse Cities"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO city (name, atlas_city_id)\nVALUES ('{{ $json.name }}', '{{ $json.atlas_city_id }}')\nON CONFLICT (atlas_city_id) DO NOTHING;",
        "options": {}
      },
